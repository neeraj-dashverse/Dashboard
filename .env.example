# Copy to .env.local and fill in. Never commit the filled-in version.

# ---------- Supabase (previous Dashverse project — ops persistence) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- Google service account (live Sheets) ----------
GOOGLE_SERVICE_ACCOUNT_EMAIL=neeraj-dashboard@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Shared Drive folder for auto-copied agency scripts (required — SAs have no My Drive quota).
# Defaults to Script copies: https://drive.google.com/drive/folders/11GwUrR6AE7vp2mvFmj3cL5FYJJ7cNeYc
# GOOGLE_SCRIPT_COPIES_FOLDER_ID=11GwUrR6AE7vp2mvFmj3cL5FYJJ7cNeYc

# Optional: force mock data even when Google creds are present
# OPS_DATA_SOURCE=mock

NEXT_PUBLIC_APP_URL=http://localhost:3000
